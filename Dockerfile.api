FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Football_Booking/ .
RUN dotnet publish Football_Booking/Football_Booking.csproj -c Release -o /app
RUN dotnet publish Pricing/Pricing.csproj -c Release -o /pricing

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
COPY --from=build /pricing /pricing
COPY docker/start-api.sh /app/start-api.sh
USER app
ENTRYPOINT ["/bin/bash", "/app/start-api.sh"]
